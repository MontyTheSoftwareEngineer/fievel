# TOML configuration. Omitted settings retain their defaults.
# Speeds are constant input units/second; scroll is notches/second.
[speeds]
normal = 800
slow = 200
fast = 1600
scroll = 8

# Keycodes received after keyd remapping, not desktop-layout characters.
# Names are case-insensitive; full Linux names such as KEY_F3 also work.
# Each binding must use a different key.
[keys]
free_mouse = "f3"
left = "h"
down = "j"
up = "k"
right = "l"
left_click = "space"
right_click = "i"
scroll_left = "n"
scroll_down = "m"
scroll_up = ","
scroll_right = "."
slow = "a"
fast = "s"
exit = "esc"
