# TOML configuration. Omitted settings retain their defaults.
# This example enables home-row remappings; built-in defaults do not.
mode = "hold" # "hold" or "toggle" for the Free Mouse Mode key
notify = true # Show a faint Wayland indicator only while Free Mouse Mode is active
home_end_enabled = true # Scroll up+down sends Home; scroll left+right sends End in Free Mouse Mode

# Pointer speeds are input units/second; scroll speeds are notches/second.
[speeds]
normal = 300
slow = 100
fast = 900
scroll = 6
scroll_slow = 1.5
scroll_fast = 24

# Fraction of the velocity gap closed per 1/60 second; 0 disables easing.
# Smaller positive values coast longer; 1 is also instantaneous.
[easing]
movement = 0.2
scroll = 0.3

# Linux keycodes, not desktop-layout characters. Optional native remappings are
# applied before these controls; see the [remap] tables below.
# Names are case-insensitive; full Linux names such as KEY_F3 also work.
# Controls must use different keys. Activation also accepts chords; their members
# may overlap controls, but are reserved until released after activating.
[keys]
free_mouse = "f3" # Or "leftalt + space"; rebind left_click in hold mode to click
left = "h"
down = "j"
up = "k"
right = "l"
left_click = "space"
right_click = "i"
scroll_left = "n"
scroll_down = "m"
scroll_up = ","
scroll_right = "."
slow = "a"
fast = "s"

# Opt-in caster overlay: while Free Mouse Mode is active, press the hotkey to
# toggle recent control-key presses at the bottom-right. Normal typing is hidden.
[keycast]
enabled = false # Set true to make the hotkey available; casting starts off
hotkey = "esc" # A distinct single key; passes through outside Free Mouse Mode
max_keys = 8 # Keep the newest 1-32 presses; discard the oldest on overflow
timeout = 3 # Clear after this many seconds without a new control press (0 < seconds <= 60)

# Home-row modifiers and navigation are enabled in this example.
# Remove or comment out all [remap...] tables and their entries to disable them.
# Chords accept either press order and consume their letters when completed.
[remap]
chord_timeout = 25 # Milliseconds to wait for a chord; unmatched keys are replayed

[remap.main]
# Hold either chord for the modifier; ordinary letters still work without a chord.
"a+s" = "super"
"s+d" = "ctrl"
"i+o" = "ctrl"
"u+i" = "super"
"a+f" = "escape"
"d+f" = "free_mouse" # Uses mode above, without sending F3; F3 still works too
"w+e" = "layer(nav)" # Hold for H/J/K/L arrows
# Tap for Ctrl; another key before 175 ms selects Ctrl for a shortcut.
# Hold alone for 175 ms to select navigation until Caps Lock is released.
capslock = "timeout(layer(control), 175, layer(nav))"

# Only active while navigation is held; Free Mouse Mode controls take precedence.
[remap.layers.nav]
h = "left"
j = "down"
k = "up"
l = "right"

# Hint mode grabs a Wayland screenshot, draws labeled boxes, and clicks the
# selected target using wlr-screencopy/layer-shell/virtual-pointer.
[hints]
color_links = true
# Detect underlined text independently, including links the same color as body text.
underline_links = true
label_symbols = "abcdefghijklmnopqrstuvwxyz"
border_color = "#00ff00e0"
# Legacy setting retained for compatibility; readability_color is used instead.
fill_color = "#00ff0018"
# Default dark box fill behind hint labels.
readability_color = "#404040e6"
label_color = "#ffffffff"
label_highlight_color = "#ffc107ff"
min_width = 8
max_width = 499
min_height = 4
max_height = 49

[hints.keys]
left = "leftmeta + space"
right = "leftmeta + i"
cancel = "enter"
# Despite the legacy setting name, hold this key to hide all hints; release to restore.
toggle_background = "leftctrl"
# Cycle hints -> snapshot edges -> grouped/rejected component bounds -> hints.
debug = "f8"
